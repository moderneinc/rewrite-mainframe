lexer grammar ControlMLexer;

UTF_8_BOM : '\uFEFF' -> skip;

WS : [ \t\f]+ -> channel(HIDDEN);
EOL : (CR? LF | FORM_FEED) -> channel(HIDDEN);

DEFINITION_START :  '<<DEFINITION_START>>' -> skip, pushMode(DEFINITION);
SCHEDULE_START : '<<SCHEDULE_START>>' -> skip, pushMode(SCHEDULE);
INPUT_START : '<<INPUT_START>>' -> skip, pushMode(INPUT);
OUTPUT_START : '<<OUTPUT_START>>' -> skip, pushMode(OUTPUT);
APP_FORM_START : '<<APP_FORM_START>>' -> skip, pushMode(APP_FORM);

LINE_START : '<<LINE_START>>|';
LINE_END : '|<<LINE_END>>';

SECTION_HEADER : '| =========================================================================== |';

ODAT : 'ODAT';
STAT : 'STAT';
PREV : 'PREV';
NEXT : 'NEXT';
PLUS_CHAR : '+';
MINUS_CHAR : '-';
INCR_DATE : PLUS_CHAR [0-9][0-9][0-9];
DECR_DATE : MINUS_CHAR [0-9][0-9][0-9];
ANY_DATE : '????' | '****' | '$$$$';
// A month and day, or a day and month, as the site writes dates.
SPECIFIC_DATE : [0-9][0-9][0-9][0-9];
// Opens a line holding one condition whose name is too long to share it.
LONG_CONDITION : '(L)';

NAME : ~[ \r\n]+;

fragment LF : '\n';
fragment CR : '\r';
fragment FORM_FEED : '\u000C';

mode DEFINITION;
DEFINITION_END : '<<DEFINITION_END>>' -> skip, popMode;
DEFINITION_DESC : 'DESC' -> pushMode(DESC_TEXT);
DEFINITION_WS : WS -> channel(HIDDEN);
DEFINITION_EOL : EOL -> channel(HIDDEN);

DEFINITION_HEADER : '+---------------------------------- BROWSE -----------------------------------+';
DEFINITION_LINE_START : LINE_START;
DEFINITION_LINE_END : LINE_END;

DEFINITION_APPL : 'APPL' -> pushMode(APPL_LINE);
DEFINITION_ARGUMENTS : 'ARGUMENTS' -> pushMode(VALUE_TEXT);
DEFINITION_CTB_STEP : 'CTB STEP' -> pushMode(CTB_STEP_LINE);
DEFINITION_DFLT : 'DFLT';
DEFINITION_DOCLIB : 'DOCLIB';
DEFINITION_DOCMEM : 'DOCMEM';
DEFINITION_MEMNAME : 'MEMNAME';
DEFINITION_MEMLIB : 'MEMLIB';
DEFINITION_NJE_NODE : 'NJE NODE';
DEFINITION_OWNER : 'OWNER';
DEFINITION_OVERLIB : 'OVERLIB';
DEFINITION_PREVENT_NCT2 : 'PREVENT-NCT2';
DEFINITION_SCHENV : 'SCHENV';
DEFINITION_SET_VAR : 'SET VAR' -> pushMode(VALUE_TEXT);
DEFINITION_STAT_CAL : 'STAT CAL';
DEFINITION_SYSTEM_ID : 'SYSTEM ID';
DEFINITION_TASKTYPE : 'TASKTYPE';

DS_NAME : NAME -> type(NAME);

mode SCHEDULE;
SCHEDULE_END : '<<SCHEDULE_END>>' -> skip, popMode;
SCHEDULE_WS : WS -> channel(HIDDEN);
SCHEDULE_EOL : EOL -> channel(HIDDEN);

SCHEDULE_HEADER : SECTION_HEADER;
SCHEDULE_LINE_START : LINE_START;
SCHEDULE_LINE_END : LINE_END;

SCHEDULE_NAME : NAME -> type(NAME);

mode INPUT;
INPUT_END : '<<INPUT_END>>' -> skip, popMode;
INPUT_NAMES_START : '<<INPUT_NAMES_START>>' -> skip, pushMode(INPUT_NAMES);

INPUT_WS : WS -> channel(HIDDEN);
INPUT_EOL : EOL -> channel(HIDDEN);

INPUT_HEADER : SECTION_HEADER;
INPUT_LINE_START : LINE_START;
INPUT_LINE_END : LINE_END;

INPUT_NAME : NAME -> type(NAME);

mode INPUT_NAMES;
INPUT_NAMES_END : '<<INPUT_NAMES_END>>' -> skip, popMode;
INPUT_NAMES_WS : WS -> channel(HIDDEN);
INPUT_NAMES_EOL : EOL -> channel(HIDDEN);

INPUT_NAMES_IN : 'IN';
INPUT_NAMES_LINE_START : LINE_START;
INPUT_NAMES_LINE_END : LINE_END;

INPUT_ODAT : ODAT -> type(ODAT);
INPUT_STAT : STAT -> type(STAT);
INPUT_PREV : PREV -> type(PREV);
INPUT_NEXT : NEXT -> type(NEXT);
INPUT_SPECIFIC_DATE : SPECIFIC_DATE -> type(SPECIFIC_DATE);
INPUT_LONG_CONDITION : LONG_CONDITION -> type(LONG_CONDITION);
INPUT_PLUS_CHAR : PLUS_CHAR -> type(PLUS_CHAR);
INPUT_MINUS_CHAR : MINUS_CHAR -> type(MINUS_CHAR);
INPUT_INCR_DATE : INCR_DATE -> type(INCR_DATE);
INPUT_DECR_DATE : DECR_DATE -> type(DECR_DATE);
INPUT_ANY_DATE : ANY_DATE -> type(ANY_DATE);
INPUT_NAMES_NAME : NAME -> type(NAME);

mode OUTPUT;
OUTPUT_END : '<<OUTPUT_END>>' -> skip, popMode;
OUTPUT_NAMES_START : '<<OUTPUT_NAMES_START>>' -> skip, pushMode(OUTPUT_NAMES);
OUTPUT_WS : WS -> channel(HIDDEN);
OUTPUT_EOL : EOL -> channel(HIDDEN);

OUTPUT_HEADER : SECTION_HEADER;
OUTPUT_LINE_START : LINE_START;
OUTPUT_LINE_END : LINE_END;

OUTPUT_NAME : NAME -> type(NAME);

mode OUTPUT_NAMES;
OUTPUT_NAMES_END : '<<OUTPUT_NAMES_END>>' -> skip, popMode;
OUTPUT_NAMES_WS : WS -> channel(HIDDEN);
OUTPUT_NAMES_EOL : EOL -> channel(HIDDEN);

OUTPUT_NAMES_OUT : 'OUT';
OUTPUT_NAMES_LINE_START : LINE_START;
OUTPUT_NAMES_LINE_END : LINE_END;

OUTPUT_ODAT : ODAT -> type(ODAT);
OUTPUT_STAT : STAT -> type(STAT);
OUTPUT_PREV : PREV -> type(PREV);
OUTPUT_NEXT : NEXT -> type(NEXT);
OUTPUT_SPECIFIC_DATE : SPECIFIC_DATE -> type(SPECIFIC_DATE);
OUTPUT_LONG_CONDITION : LONG_CONDITION -> type(LONG_CONDITION);
OUTPUT_PLUS_CHAR : PLUS_CHAR -> type(PLUS_CHAR);
OUTPUT_MINUS_CHAR : MINUS_CHAR -> type(MINUS_CHAR);
OUTPUT_INCR_DATE : INCR_DATE -> type(INCR_DATE);
OUTPUT_DECR_DATE : DECR_DATE -> type(DECR_DATE);
OUTPUT_ANY_DATE : ANY_DATE -> type(ANY_DATE);
OUTPUT_NAMES_NAME : NAME -> type(NAME);

mode APP_FORM;
APP_FORM_END : '<<APP_FORM_END>>' -> skip, popMode;
APP_FORM_WS : WS -> channel(HIDDEN);
APP_FORM_EOL : EOL -> channel(HIDDEN);

APP_FORM_SECTION_HEADER : SECTION_HEADER -> type(SECTION_HEADER);
APP_FORM_LINE_START : LINE_START;
APP_FORM_LINE_END : LINE_END;

APP_FORM_NAME : NAME -> type(NAME);

// The labels of the APPL line are its own, so a value elsewhere that reads TBL, a task type say,
// stays a value.
mode APPL_LINE;
APPL_LINE_END : LINE_END -> type(DEFINITION_LINE_END), popMode;
APPL_LINE_WS : WS -> channel(HIDDEN);
APPL_LINE_EOL : EOL -> channel(HIDDEN);

DEFINITION_GROUP : 'GROUP';
DEFINITION_TBL : 'TBL';
DEFINITION_RBC : 'RBC';
APPL_LINE_NAME : NAME -> type(NAME);

mode CTB_STEP_LINE;
CTB_STEP_LINE_END : LINE_END -> type(DEFINITION_LINE_END), popMode;
CTB_STEP_LINE_WS : WS -> channel(HIDDEN);
CTB_STEP_LINE_EOL : EOL -> channel(HIDDEN);

CTB_STEP_AT : 'AT';
CTB_STEP_NAME : 'NAME';
CTB_STEP_TYPE : 'TYPE';
CTB_STEP_LINE_NAME : NAME -> type(NAME);

// A value that may hold blanks, which runs to the end of the line.
mode VALUE_TEXT;
VALUE_TEXT_END : LINE_END -> type(DEFINITION_LINE_END), popMode;
VALUE_TEXT_WS : WS -> channel(HIDDEN);
VALUE_TEXT_EOL : EOL -> channel(HIDDEN);

DEFINITION_EQUALS_CHAR : '=';
VALUE_TEXT_NAME : NAME -> type(NAME);

mode DESC_TEXT;
DESC_TEXT_END : LINE_END -> type(DEFINITION_LINE_END), popMode;
DESC_TEXT_WS : WS -> channel(HIDDEN);
DESC_TEXT_EOL : EOL -> channel(HIDDEN);

DESC_TEXT_LINE_START : LINE_START -> skip;
DESC_TEXT_DESC : DEFINITION_DESC -> type(DEFINITION_DESC);
DESC_TEXT_WORD : ~[ \r\n]+;
